# ---- Database (Neon Postgres) ----
# Pooled connection string from the Neon dashboard.
DATABASE_URL=

# ---- Clerk (authentication) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the production webhook endpoint (Clerk dashboard → Webhooks).
# Leave as a placeholder locally; set the real value in Vercel after deploy.
CLERK_WEBHOOK_SIGNING_SECRET=

# ---- Clerk routing ----
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/theses
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/theses

# ---- AI / agent (Phase 3) ----
# Not required when USE_AI_FIXTURES=1 (offline fixtures).
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
# SEC requires a descriptive User-Agent with a contact. Put YOUR contact here in
# .env.local (this example file is committed — use a placeholder).
EDGAR_USER_AGENT=thesis-tracker/1.0 (you@example.com)
# Inngest (prod). Locally the Inngest dev server needs neither.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 in dev to replay agent runs from __fixtures__ (no network, no cost).
USE_AI_FIXTURES=1
